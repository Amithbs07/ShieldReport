// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports     Report[]
  admins      Admin[]
}

model Admin {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  role           String       @default("VIEWER") // ADMIN, INVESTIGATOR, VIEWER
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Report {
  id              String       @id @default(uuid())
  caseToken       String       @unique // the unique 12-char tracker
  description     String       // encrypted at rest
  category        String
  severity        String       // LOW, MEDIUM, HIGH, CRITICAL
  status          String       @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, INVESTIGATION_STARTED, ACTION_TAKEN, RESOLVED
  aiUrgencyScore  Float?
  aiSummary       String?
  aiTags          String?
  incidentSchedule String?     // structured JSON schedule and timeline
  nlpFraudScore   Float?       // NLP fraud/spam probability score 0-100
  nlpCredibilityScore Float?   // NLP witness credibility score 0-100
  nlpAnalysis     String?      // NLP linguistic forensic reasoning
  
  // DistilBERT Emotion Analysis (inspired by IEEE 11452105)
  emotionPrimary  String?      // Fear, Distress, Anger, Trauma, Calm
  emotionIntensity Float?      // 0-100%
  isHighRiskCrisis Boolean     @default(false)
  crisisInterventionNotes String?

  // Blockchain Chain-of-Custody Notary
  blockchainTxHash String?
  blockchainBlockNumber Int?
  blockchainBlockHash String?
  merkleRoot      String?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  messages        Message[]
  evidence        Evidence[]
}

model Evidence {
  id               String    @id @default(uuid())
  reportId         String
  report           Report    @relation(fields: [reportId], references: [id])
  fileName         String
  fileSize         Int
  fileType         String
  dataUrl          String?
  sha256Hash       String
  cvAuthenticity   Float     @default(98.5) // CV authenticity probability 0-100
  cvTamperScore    Float     @default(1.5)  // CV manipulation probability 0-100
  cvCategory       String?   // DOCUMENT, IMAGE_SCENE, SCREENSHOT, INJURY_HAZARD
  cvElaScore       Float?    // Error Level Analysis score
  blockchainProof  String?   // Individual evidence hash anchor
  approvalStatus   String    @default("PENDING_MANUAL_APPROVAL") // PENDING_MANUAL_APPROVAL, APPROVED, REJECTED
  reviewerNotes    String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
}

model BlockchainBlock {
  id                 String   @id @default(uuid())
  blockNumber        Int      @unique
  timestamp          DateTime @default(now())
  previousHash       String
  blockHash          String   @unique
  caseTokenHash      String
  reportContentHash  String
  evidenceMerkleRoot String
  nonce              Int      @default(0)
  createdAt          DateTime @default(now())
}

model Message {
  id          String   @id @default(uuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id])
  senderType  String   // REPORTER or ADMIN
  content     String   // encrypted at rest
  createdAt   DateTime @default(now())
}

